# ─────────────────────────────────────────────────────────
#  FraudGuard Backend — Environment Variables Reference
#  Copy this file to .env and fill in your own values.
#  NEVER commit the actual .env file to version control.
# ─────────────────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development      # Set to "production" on cloud

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password_here
DB_NAME=job_scam_db
DB_SSL=false              # Set to "REQUIRED" or "true" for cloud providers (e.g. Aiven)

# Session & Auth
SESSION_SECRET=your_session_secret_here
JWT_SECRET=your_jwt_secret_here

# ML Service URL
# Local development: leave unset or set to http://127.0.0.1:5001
# Cloud production: set to the deployed ML service URL, e.g.
# ML_API_URL=https://fraudguard-ml.onrender.com
ML_API_URL=http://127.0.0.1:5001
